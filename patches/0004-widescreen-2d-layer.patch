diff -ru a/doomgeneric/i_video.h b/doomgeneric/i_video.h
--- a/doomgeneric/i_video.h	2026-09-22 22:13:43
+++ b/doomgeneric/i_video.h	2026-09-22 22:13:44
@@ -27,6 +27,14 @@
 #define SCREENWIDTH  320
 #define SCREENHEIGHT 200
 
+// RESODOOM: the geometry Doom's 2D art was drawn for, and how far right
+// it must move to sit centred in a wider buffer. DELTAWIDTH is a macro
+// on purpose: it expands where it is used, after ResodoomHooks.h has
+// redefined SCREENWIDTH, so it always sees the real width. 0 at 320.
+#define ORIGWIDTH  320
+#define ORIGHEIGHT 200
+#define DELTAWIDTH ((SCREENWIDTH - ORIGWIDTH) / 2)
+
 // Screen width used for "squash" scale functions
 
 #define SCREENWIDTH_4_3 256
