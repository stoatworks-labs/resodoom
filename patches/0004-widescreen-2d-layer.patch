diff -ru a/doomgeneric/v_video.c b/doomgeneric/v_video.c
--- a/doomgeneric/v_video.c	2026-09-22 22:13:43
+++ b/doomgeneric/v_video.c	2026-09-22 22:13:44
@@ -136,6 +136,26 @@
 // Masks a column based masked pic to the screen. 
 //
 
+// RESODOOM: black the two strips a full-screen 320-wide page leaves
+// uncovered in a wider buffer. Without this they keep whatever was drawn
+// there last -- after the first attract demo, a slice of the 3D view
+// beside the title page. Palette index 0 is Doom's black.
+void V_ClearPillarbox(void)
+{
+    int y;
+
+    if (DELTAWIDTH <= 0)
+        return;
+
+    for (y = 0; y < SCREENHEIGHT; ++y)
+    {
+        byte *row = dest_screen + y * SCREENWIDTH;
+        memset(row, 0, DELTAWIDTH);
+        memset(row + DELTAWIDTH + ORIGWIDTH, 0,
+               SCREENWIDTH - DELTAWIDTH - ORIGWIDTH);
+    }
+}
+
 void V_DrawPatch(int x, int y, patch_t *patch)
 { 
     int count;
@@ -146,6 +166,20 @@
     byte *source;
     int w;
 
+    // RESODOOM: callers speak 320-space; move it to the middle of the
+    // real buffer. Done before the offsets and the range check, so both
+    // see final screen coordinates. A 320x200 patch at the origin is by
+    // definition a full-screen page -- title, credits, help, intermission,
+    // finale art -- and gets its pillarbox cleared: detecting it here
+    // cannot miss one of the six places that draw a page.
+    if (x == 0 && y == 0
+     && SHORT(patch->width) == ORIGWIDTH
+     && SHORT(patch->height) == ORIGHEIGHT)
+    {
+        V_ClearPillarbox();
+    }
+    x += DELTAWIDTH;
+
     y -= SHORT(patch->topoffset);
     x -= SHORT(patch->leftoffset);
 
@@ -210,6 +244,9 @@
     byte *source; 
     int w; 
  
+    // RESODOOM: 320-space, as V_DrawPatch.
+    x += DELTAWIDTH;
+
     y -= SHORT(patch->topoffset); 
     x -= SHORT(patch->leftoffset); 
 
